# Session
SESSION_COOKIE_NAME=forging_admin_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Super Admin Bootstrap
FIRST_SUPERADMIN_EMAIL=admin@forgingcms.com
FIRST_SUPERADMIN_PASSWORD=Admin@123456
FIRST_SUPERADMIN_NAME="System Super Admin"

# Mail Placeholders
