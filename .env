APP_ENV=development
APP_DEBUG=true
APP_NAME="Forging CMS"
DISABLE_SQLALCHEMY_CEXT=1
SECRET_KEY=dev_secret_key_87fdb209_5dd9_4f14_9c4d_4b3e2f8d5110_ultra_secure_local
SITE_URL=http://localhost:8000

# SQLite for local development
DATABASE_URL=sqlite:///./forging.db

# Uploads
UPLOAD_DIR=./uploads
