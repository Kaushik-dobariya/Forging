# ==============================================================================
# FORGING CMS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Forging CMS"
# Set to 1 if running on environments where unsigned C-extensions are restricted by OS policies
DISABLE_SQLALCHEMY_CEXT=1

# Security: Generate a strong secret key for production (e.g. using openssl rand -hex 32)
SECRET_KEY=change_this_to_a_very_secure_random_string_in_production_min_32_chars

# Public Website & Base URL
SITE_URL=http://localhost:8000

# Database Configuration
# Local SQLite Development:
DATABASE_URL=sqlite:///./forging.db
# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://forging_user:secret_password@127.0.0.1:3306/forging_cms?charset=utf8mb4

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760 # 10MB in bytes

# Session and Cookie Configuration
SESSION_COOKIE_NAME=forging_admin_session
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false # Set to true in production over HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Initial Super Admin Bootstrap (Created if not exists on application boot or via CLI)
FIRST_SUPERADMIN_EMAIL=admin@forgingcms.com
FIRST_SUPERADMIN_PASSWORD=Admin@123456
FIRST_SUPERADMIN_NAME="System Super Admin"

# Mail Settings (Placeholders for future notification & lead email pipelines)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@forgingcms.com
MAIL_PASSWORD=change_me
MAIL_FROM=no-reply@forgingcms.com
MAIL_TLS=true
MAIL_SSL=false
